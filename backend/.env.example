# Copy manually into a private environment; never commit real credentials.
DJANGO_ENV=development
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
SECRET_KEY=
# PostgreSQL is primary; no automatic fallback to backend/db.sqlite3.
DATABASE_ENGINE=postgresql
POSTGRES_DB=prepal_local_dev
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_STATEMENT_TIMEOUT_MS=15000
POSTGRES_LOCK_TIMEOUT_MS=5000
POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=60000
POSTGRES_CONN_MAX_AGE=0
# Provisioned runtime.env is separate from migration.env and backup.env.
# PREPAL_LOCAL_POSTGRES=1
# PREPAL_ENVIRONMENT=staging or production (only matching guarded settings).
# Production requires verify-full and a trusted CA / POSTGRES_SSLROOTCERT.
# POSTGRES_SSLROOTCERT=/absolute/private/path/ca.crt
# PRIVATE_MEDIA_ROOT=/absolute/private/path/media
# STATIC_ROOT=/absolute/public/static/directory
# SQLite is explicit and nonproduction only; choose a NEW disposable path.
# DATABASE_ENGINE=sqlite
# DATABASE_PATH=/absolute/private/new-copy.sqlite3
AI_ENABLED=false
AI_GUEST_ENABLED=false
GEMINI_API_KEY=
AI_MODEL=
AI_DAILY_BUDGET_MICRO=0
AI_INPUT_RATE_MICRO=0
AI_OUTPUT_RATE_MICRO=0
SUPPORT_EMAIL=
TRUST_PROXY_SSL=false
TRUSTED_PROXY_IPS=
# Historical ID allowlist cannot bypass persisted QuizReview approval.
APPROVED_QUIZ_IDS=

# Student identity: production defaults off until migrations and acceptance are verified.
STUDENT_FEATURES_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SITE_ORIGIN=http://127.0.0.1:5173
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# Explicit free Render demo ONLY; not production and not enabled by this template.
# DJANGO_ENV=production
# DEBUG=false
# PREPAL_ENVIRONMENT=free-demo
# PREPAL_FREE_DEMO=1
# PREPAL_FREE_DEMO_SYNTHETIC_DATA=1
# Existing SECRET_KEY and STAGING_ACCESS_USERNAME/STAGING_ACCESS_PASSWORD stay private.
# Use the actual external Render POSTGRES_HOST, POSTGRES_SSLMODE=verify-full.
# POSTGRES_SSLROOTCERT is optional only when the pinned certifi bundle is suitable.

# Separate controlled-login hosted demo, AFTER account/grant/config approval:
# PREPAL_ENVIRONMENT=public-demo
# PREPAL_PUBLIC_DEMO=1
# Keep both PREPAL_FREE_DEMO flags above, existing runtime secrets and verify-full.
# Use core.render_public_demo_settings via deploy/render-public-demo-start.sh.
# Registration, Google, Gemini and uploads are forced off; never use real students.
# Start: bash deploy/render-free-demo-start.sh (never migrates/seeds).
# No uploads or valuable student data are allowed; free database expires.
