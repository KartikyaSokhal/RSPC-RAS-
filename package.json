{
  "name": "ras-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:student": "backend/.venv/bin/python scripts/run_student_dev.py",
    "build": "vite build",
    "lint": "eslint src *.config.js e2e e2e-integration e2e-sample e2e-student e2e-public-demo scripts/*.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "playwright test --config=playwright.integration.config.js",
    "test:sample": "playwright test --config=playwright.sample.config.js",
    "test:backend": "cd backend && python run_tests.py",
    "check": "npm run lint && npm run test && npm run build",
    "test:student": "playwright test --config=playwright.student.config.js",
    "test:public-demo": "playwright test --config=playwright.public-demo.config.js"
  },
  "dependencies": {
    "axios": "1.20.0",
    "dompurify": "3.4.17",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "30.1.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": ">=11 <12"
  }
}
